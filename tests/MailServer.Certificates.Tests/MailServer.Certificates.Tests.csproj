<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Certificate behaviour: generation, storage, hot reload and expiry escalation.

    A separate project from MailServer.SecurityTests because these need the full persistence
    stack and a writable certificate directory. Keeping them apart means "did the security
    tests run?" stays answerable from CI output alone, which was the reason that project was
    separated in the first place.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MailServer.Certificates.Tests</RootNamespace>
    <AssemblyName>MailServer.Certificates.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MailServer.Domain\MailServer.Domain.csproj" />
    <ProjectReference Include="..\..\src\MailServer.Application\MailServer.Application.csproj" />
    <ProjectReference Include="..\..\src\MailServer.Infrastructure\MailServer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MailServer.Persistence.Sqlite\MailServer.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
