    <RootNamespace>MailServer.Ipc.Tests</RootNamespace>
    <AssemblyName>MailServer.Ipc.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MailServer.Domain\MailServer.Domain.csproj" />
    <ProjectReference Include="..\..\src\MailServer.Application\MailServer.Application.csproj" />
    <ProjectReference Include="..\..\src\MailServer.Ipc\MailServer.Ipc.csproj" />
