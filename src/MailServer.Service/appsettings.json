{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },

  "MailServer": {
    "Server": {
      "//": "The single most consequential setting. It is announced in EHLO, must match the PTR record for the sending IP, must appear in the TLS certificate SAN list, and is what the MX record points at.",
      "Hostname": "mail.example.com",
      "PublicIpAddress": null,
      "ProductName": "AetherMail Server"
    },

    "Database": {
      "Provider": "Sqlite",
      "Sqlite": {
        "DataSource": "Data/mailserver.db",
        "BusyTimeoutMs": 5000,
        "JournalMode": "WAL",
        "Synchronous": "NORMAL",
        "CacheSizeKilobytes": 16384,
        "EnforceForeignKeys": true
      },
      "SqlServer": {
        "//": "In production leave ConnectionString empty and use ConnectionStringSecretName, so no credential is ever written to a JSON file.",
        "ConnectionString": null,
        "ConnectionStringSecretName": null,
        "CommandTimeoutSeconds": 30,
        "MaxRetryAttempts": 5
      },
      "Migrations": {
        "RunOnStartup": true,
        "BackupBeforeDestructive": true,
        "CommandTimeoutSeconds": 300
      }
    },

    "Storage": {
      "DataRoot": "Data",
      "MaxMessageSizeBytes": 36700160,
      "MinimumFreeDiskBytes": 2147483648
    },

    "Ipc": {
      "PipeName": "AetherMail.Admin",
      "MaxFrameBytes": 4194304,
      "RequestTimeoutSeconds": 60,
      "MaxConcurrentConnections": 8
    },

    "Security": {
      "SecretProtection": "Dpapi",
      "AdminLockoutThreshold": 5,
      "AdminLockoutMinutes": 15,
      "AutoLockMinutes": 10
    },

    "Limits": {
      "MaxRecipientsPerMessage": 100,
      "MaxConcurrentConnectionsPerIp": 10,
      "MaxConcurrentConnectionsTotal": 500,
      "SmtpCommandTimeoutSeconds": 300,
      "SmtpSessionTimeoutSeconds": 600,
      "MaxSmtpLineBytes": 4096,
      "MaxHeaderBytes": 262144,
      "MaxMimeDepth": 20,
      "MaxAuthAttemptsPerSession": 3
    },

    "Maintenance": {
      "Mode": "Normal"
    }
  }
}
