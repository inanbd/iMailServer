<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf project. Same shape as the SQLite provider: connection factory, ISqlDialect,
    embedded migrations, one DI registration extension.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MailServer.Persistence.SqlServer</RootNamespace>
    <AssemblyName>MailServer.Persistence.SqlServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailServer.Application\MailServer.Application.csproj" />
    <ProjectReference Include="..\MailServer.Domain\MailServer.Domain.csproj" />
    <ProjectReference Include="..\MailServer.Infrastructure\MailServer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

</Project>
