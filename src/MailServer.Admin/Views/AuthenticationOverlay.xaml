<UserControl x:Class="MailServer.Admin.Views.AuthenticationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MailServer.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AuthenticationViewModel}"
             Background="{StaticResource Surface.Background}">

    <!--
        Covers the entire window until authenticated. The shell's content is not merely
        disabled behind it but collapsed, so no mailbox or domain data is on screen while
        the console is locked.
    -->
    <Grid>
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}"
                BorderThickness="1" Padding="32">
            <StackPanel>

                <TextBlock Text="AetherMail Server" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                           Text="Administration console" />

                <!-- Status / guidance -->
                <Border Background="#FFF0F6FF" BorderBrush="#FF9AC0E8" BorderThickness="1"
                        Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Border>

                <!-- Errors. Always the service's own wording. -->
                <Border Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <!-- ==================== CONNECTING ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Connecting}">
                    <TextBlock Text="Connecting to the AetherMail service…"
                               Style="{StaticResource Caption}" />
                </StackPanel>

                <!-- ==================== FIRST-RUN SETUP ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Setup}">
                    <TextBlock Text="Create the master password" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="This password controls every domain, mailbox, certificate and DKIM key on this server. Use a passphrase of at least " />
                        <Run Text="{Binding MinimumPasswordLength, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" characters. It is never stored — only a hash of it." />
                    </TextBlock>

                    <TextBlock Text="Master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="SetupPassword" Margin="0,2,0,10" Padding="4,4" />

                    <TextBlock Text="Confirm master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="SetupConfirmPassword" Margin="0,2,0,14" Padding="4,4" />

                    <Button Content="Create and continue" Click="OnCompleteSetup"
                            HorizontalAlignment="Left" MinWidth="170"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>

                <!-- ==================== RECOVERY KEY, SHOWN ONCE ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=ShowRecoveryKey}">
                    <TextBlock Text="Write down the recovery key" Style="{StaticResource SectionHeader}" />

                    <Border Background="#FFFFF4CE" BorderBrush="{StaticResource State.Warning}"
                            BorderThickness="1" Padding="10" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="This is the only time this key will be shown. The server keeps only a hash of it. If the master password is lost and this key is not available, the server cannot be recovered and must be rebuilt." />
                    </Border>

                    <Border Background="#FFF5F5F5" BorderBrush="{StaticResource Surface.Border}"
                            BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <TextBox Text="{Binding RecoveryKeyToDisplay, Mode=OneWay}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="16"
                                 HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>

                    <CheckBox Content="I have recorded this recovery key somewhere safe"
                              IsChecked="{Binding HasWrittenDownRecoveryKey, Mode=TwoWay}"
                              Margin="0,0,0,14" />

                    <Button Content="Continue" Command="{Binding AcknowledgeRecoveryKeyCommand}"
                            HorizontalAlignment="Left" MinWidth="130" />
                </StackPanel>

                <!-- ==================== SIGN IN ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=SignIn}">
                    <TextBlock Text="Sign in" Style="{StaticResource SectionHeader}" />

                    <Border Background="#FFFDE7E9" BorderBrush="{StaticResource State.Critical}"
                            BorderThickness="1" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Too many failed attempts. Sign-in is temporarily locked. The recovery key still works." />
                    </Border>

                    <TextBlock Text="Master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="SignInPassword" Margin="0,2,0,14" Padding="4,4"
                                 KeyDown="OnSignInKeyDown" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Sign in" Click="OnSignIn" MinWidth="120"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="Use recovery key" Command="{Binding ShowRecoveryCommand}"
                                MinWidth="150" />
                    </StackPanel>
                </StackPanel>

                <!-- ==================== RECOVERY ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Recovery}">
                    <TextBlock Text="Reset with recovery key" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Recovery key" Style="{StaticResource Caption}" />
                    <TextBox x:Name="RecoveryKeyEntry" Margin="0,2,0,10" FontFamily="Consolas" />

                    <TextBlock Text="New master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="RecoveryNewPassword" Margin="0,2,0,10" Padding="4,4" />

                    <TextBlock Text="Confirm new master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="RecoveryConfirmPassword" Margin="0,2,0,14" Padding="4,4" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Reset password" Click="OnResetWithRecoveryKey" MinWidth="140"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="Cancel" Command="{Binding CancelRecoveryCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- ==================== MANDATORY PASSWORD CHANGE ==================== -->
                <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=ChangeRequired}">
                    <TextBlock Text="Choose a new master password" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="The password was set using a recovery key. No other operation is permitted until a new password is chosen." />

                    <TextBlock Text="Current password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="RequiredCurrentPassword" Margin="0,2,0,10" Padding="4,4" />

                    <TextBlock Text="New master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="RequiredNewPassword" Margin="0,2,0,10" Padding="4,4" />

                    <TextBlock Text="Confirm new master password" Style="{StaticResource Caption}" />
                    <PasswordBox x:Name="RequiredConfirmPassword" Margin="0,2,0,14" Padding="4,4" />

                    <Button Content="Set password" Click="OnCompleteRequiredChange"
                            HorizontalAlignment="Left" MinWidth="140"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                           Text="Working…" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
