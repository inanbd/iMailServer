<UserControl x:Class="MailServer.Admin.Views.Pages.DomainsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MailServer.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DomainsViewModel}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Domains" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Mail domains hosted by this server. A new domain starts in Pending: it does not accept mail until DKIM is generated, DNS is published and it is enabled." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Margin="0,12,0,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Visibility="{Binding ErrorCorrelationId, Converter={StaticResource StringToVisibility}}">
                    <Run Text="Correlation id: " />
                    <Run Text="{Binding ErrorCorrelationId, Mode=OneWay}" FontFamily="Consolas" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Search -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,8">
            <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Search" Command="{Binding SearchCommand}" Margin="6,0,0,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Domains}"
                  SelectedItem="{Binding SelectedDomain, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="24">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding Status, Converter={StaticResource DomainStatusToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Domain" Binding="{Binding DisplayName}" Width="220" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Mail hostname" Binding="{Binding MailHostname}" Width="220" />
                <DataGridTextColumn Header="DKIM selector" Binding="{Binding ActiveDkimSelector}" Width="130" />
                <DataGridTextColumn Header="Mailboxes" Binding="{Binding MailboxCount}" Width="90" />
                <DataGridTextColumn Header="Storage"
                                    Binding="{Binding StorageUsedBytes, Converter={StaticResource ByteSize}}"
                                    Width="100" />
                <DataGridTextColumn Header="Created (UTC)"
                                    Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paging and per-selection actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
            <Button Content="Next" Command="{Binding NextPageCommand}" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,20,0">
                <Run Text="Page " />
                <Run Text="{Binding Page, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding TotalCount, Mode=OneWay, FallbackValue=?}" />
                <Run Text=" domain(s)" />
            </TextBlock>

            <Button Content="Enable" Command="{Binding EnableDomainCommand}" />
            <Button Content="Disable" Command="{Binding DisableDomainCommand}" />
            <Button Content="Mark for deletion" Command="{Binding MarkForDeletionCommand}" MinWidth="140" />
        </StackPanel>

        <!-- Create, and the guarded permanent delete -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Add a domain" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                    <TextBlock Text="Domain name" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding NewDomainName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8" />

                    <TextBlock Text="Mail hostname (optional; required before the domain can be enabled)"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NewDomainMailHostname, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8" />

                    <TextBlock Text="Default mailbox quota (GB; 0 means unlimited)" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding NewDomainQuotaGigabytes, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Left" Margin="0,2,0,10" />

                    <Button Content="Create domain" Command="{Binding CreateDomainCommand}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!--
                Permanent deletion is guarded by typing the domain name, matching how Windows
                Server tooling protects destructive operations. The button stays disabled
                until the typed text matches the selected row exactly.
            -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Delete permanently" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="This removes the domain outright. It is refused while the domain still has mailboxes, because deleting it would orphan every stored message belonging to them." />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0">
                        <Run Text="Type the domain name to confirm: " />
                        <Run Text="{Binding SelectedDomain.Name, Mode=OneWay, FallbackValue=(select a domain)}"
                             FontWeight="SemiBold" />
                    </TextBlock>

                    <TextBox Text="{Binding DeleteConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,10" />

                    <Button Content="Delete permanently"
                            Command="{Binding DeletePermanentlyCommand}"
                            IsEnabled="{Binding CanDeletePermanently}"
                            HorizontalAlignment="Left"
                            MinWidth="150"
                            Foreground="{StaticResource State.Critical}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
