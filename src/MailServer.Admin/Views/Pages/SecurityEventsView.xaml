<UserControl x:Class="MailServer.Admin.Views.Pages.SecurityEventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MailServer.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecurityEventsViewModel}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Security Events" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Sign-ins, lockouts, rejected recovery keys and invalid sessions. Kept separately from the audit trail because these are recorded even when nothing changed — and especially when an operation failed." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Margin="0,12,0,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="Show all / only notable" Command="{Binding ToggleAlarmingOnlyCommand}"
                    MinWidth="180" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0">
                <Run Text="Showing: " />
                <Run Text="{Binding AlarmingOnly, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" (notable only)" />
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="24">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding EventType, Converter={StaticResource SecurityEventToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="When (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="150" />
                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="230" />
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="150" />
                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="190" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}"
                                    Width="160" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
            <Button Content="Next" Command="{Binding NextPageCommand}" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0">
                <Run Text="Page " />
                <Run Text="{Binding Page, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding TotalCount, Mode=OneWay, FallbackValue=?}" />
                <Run Text=" event(s)" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
