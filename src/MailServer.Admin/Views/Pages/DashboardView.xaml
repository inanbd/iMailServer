<UserControl x:Class="MailServer.Admin.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MailServer.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}">
                <Run Text="{Binding ServerHostname, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding DatabaseProvider, Mode=OneWay}" />
                <Run Text=" · version " />
                <Run Text="{Binding ProductVersion, Mode=OneWay}" />
            </TextBlock>

            <!-- Error banner. Shows the correlation id so the operator can quote it. -->
            <Border Style="{StaticResource ErrorBanner}" Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding ErrorCorrelationId, Converter={StaticResource StringToVisibility}}">
                        <Run Text="Correlation id: " />
                        <Run Text="{Binding ErrorCorrelationId, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Counters -->
            <TextBlock Text="Mail" Style="{StaticResource SectionHeader}" />
            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="150">
                    <StackPanel>
                        <TextBlock Text="{Binding Counters.DomainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Domains" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="150">
                    <StackPanel>
                        <TextBlock Text="{Binding Counters.ActiveDomainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Active domains" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="150">
                    <StackPanel>
                        <TextBlock Text="{Binding Counters.MailboxCount, FallbackValue=0}"
                                   Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Mailboxes" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="150">
                    <StackPanel>
                        <TextBlock Text="{Binding Counters.QueuedMessageCount, FallbackValue=0}"
                                   Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Queued" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="170">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricValue}"
                                   Text="{Binding Counters.StorageUsedBytes, Converter={StaticResource ByteSize}, FallbackValue=0}" />
                        <TextBlock Text="Mail storage used" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Health. The state name is always shown next to the colour. -->
            <TextBlock Text="Health" Style="{StaticResource SectionHeader}" />
            <DataGrid ItemsSource="{Binding Health}" MaxHeight="320">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding State, Converter={StaticResource HealthStateToBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="190" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="Observed (UTC)"
                                        Binding="{Binding ObservedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                        Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="Last refreshed " />
                    <Run Text="{Binding LastRefreshedUtc, StringFormat=HH:mm:ss, Mode=OneWay}" />
                    <Run Text=" UTC" />
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
