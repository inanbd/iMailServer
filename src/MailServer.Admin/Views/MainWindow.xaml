<Window x:Class="MailServer.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MailServer.Admin.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="AetherMail Server — Administration"
        Height="820" Width="1320"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource Surface.Background}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Maintenance banner. Shown across the full width and impossible to miss:
            an operator wondering why mail is not flowing must see the reason first.
        -->
        <Border Grid.Row="0" Style="{StaticResource MaintenanceBanner}"
                Visibility="{Binding MaintenanceMode, Converter={StaticResource MaintenanceModeToVisibility}}">
            <TextBlock FontWeight="SemiBold">
                <Run Text="MAINTENANCE MODE: " />
                <Run Text="{Binding MaintenanceMode, Mode=OneWay}" />
                <Run Text=" — mail flow is restricted." />
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation. Grouped, fixed, always visible: Server Manager, not a hamburger. -->
            <Border Grid.Column="0" Background="{StaticResource Surface.Navigation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationEntries}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource NavigationGroupHeader}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsAvailable}"
                                        HorizontalContentAlignment="Left"
                                        Padding="24,5,10,5"
                                        Margin="0"
                                        MinWidth="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{StaticResource Surface.NavigationText}"
                                        ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Content region. One ContentControl; pages are selected by DataTemplate. -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Border}" BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding OverallHealth, Converter={StaticResource HealthStateToBrush}}" />
                    <TextBlock Text="{Binding OverallHealth}" Margin="6,0,0,0"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}"
                           Style="{StaticResource Caption}" Margin="16,0,0,0"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Text="The mail service runs independently of this application. Closing this window does not stop mail." />
            </Grid>
        </Border>

    </Grid>
</Window>
