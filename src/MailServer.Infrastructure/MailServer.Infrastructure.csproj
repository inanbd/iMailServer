<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements the Application layer's ports with concrete technology.
    Provider-specific packages (Microsoft.Data.Sqlite / Microsoft.Data.SqlClient) do NOT
    belong here - they live in the leaf persistence projects. Infrastructure holds the
    provider-NEUTRAL persistence machinery: migration runner, transaction manager, and
    the Dapper repository implementations written once against ISqlDialect.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MailServer.Infrastructure</RootNamespace>
    <AssemblyName>MailServer.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MailServer.Application\MailServer.Application.csproj" />
    <ProjectReference Include="..\MailServer.Domain\MailServer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A real Mozilla Public Suffix List snapshot (see https://publicsuffix.org/list/), embedded
      rather than fetched live: DMARC's relaxed alignment needs the organizational domain, which
      cannot be computed correctly without it (docs/DMARC.md). The file's own "// VERSION:"
      comment records the snapshot date; PublicSuffixListLoader parses it so the snapshot's age
      is a known fact, not an assumption. Refreshing this file from publicsuffix.org is an
      operational task, not something this server does at runtime.
    -->
    <EmbeddedResource Include="Dmarc\public_suffix_list.dat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Certes" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="DnsClient" />
  </ItemGroup>

</Project>
